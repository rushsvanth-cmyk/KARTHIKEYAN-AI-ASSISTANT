        if (isdigit(input[0])) 
        {
            stringstream ss(input);
            if (ss >> num1 >> op >> num2) {
                cout << "Assistant (Math): ";
                switch(op) {
                    case '+': cout << num1 + num2 << " ✅"; break;
                    case '-': cout << num1 - num2 << " ✅"; break;
