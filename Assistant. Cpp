#include <iostream>
#include <string>
#include <algorithm> 
#include <cmath>
#include <ctime>
#include <sstream> 
#include <unistd.h> 
#include <chrono> 
#include <fstream> 
#include <vector> // [NEW] Required for using dynamic vectors instead of rigid arrays

using namespace std;

// File name for storage
const string FILE_NAME = "tasks.txt";

// [UPGRADED] Using std::vector to allow infinite/dynamic storage expansion
static vector<string> tasks; 

// [CHANGED] Saves dynamically sized vector data to the text file
void saveTasksToFile() {
    ofstream outFile(FILE_NAME);
    if (outFile.is_open()) {
        for (const string& task : tasks) {
            outFile << task << endl;
        }
        outFile.close();
    }
}

// [CHANGED] Loads items directly into the dynamic vector container
void loadTasksFromFile() {
    ifstream inFile(FILE_NAME);
    if (inFile.is_open()) {
        string task;
        tasks.clear(); // Wipe runtime cache before reloading
        while (getline(inFile, task)) {
            if (!task.empty()) {
                tasks.push_back(task); // Dynamically appends items to vector
            }
        }
        inFile.close();
    }
}

int main() 
{
    string input;
    double num1, num2;
    char op;

    // Load saved tasks dynamically when the program boots up
    loadTasksFromFile();

    cout << "--- System Online (V5.2 - Dynamic Vector Engine) ---" << endl;
    cout << "(Commands: hi, status, ev health, add task, remove task, list, exit)" << endl;
    if (!tasks.empty()) {
        cout << "Assistant: Welcome back Karthikeyan! Restored " << tasks.size() << " active tasks from storage. 💾" << endl;
    }

    while (true)
    {
        cout << "\nYou: ";
        getline(cin, input);

        if (input.empty()) continue;

        auto start_time = chrono::high_resolution_clock::now();

        // --- 1. Automatic Math Detection ---
        if (isdigit(input[0])) 
        {
            stringstream ss(input);
            if (ss >> num1 >> op >> num2) 
            {
                cout << "Assistant (Math): ";
                switch(op) 
                {
                    case '+': cout << num1 + num2 << " ✅"; break;
                    case '-': cout << num1 - num2 << " ✅"; break;
                    case '*': cout << num1 * num2 << " ✅"; break;
                    case '/': 
                        if(num2 != 0) cout << num1 / num2 << " ✅";
                        else cout << "Error: Cannot divide by zero! ❌";
                        break;
                    case '^': cout << pow(num1, num2) << " 🔥"; break;
                    default: cout << "Unknown operator! 😅";
                }
                cout << endl;
                continue; 
            }
        }

        string lowerInput = input;
        transform(lowerInput.begin(), lowerInput.end(), lowerInput.begin(), [](unsigned char c){ return tolower(c); });

        // --- 2. Basic System Commands ---
        if (lowerInput == "exit" || lowerInput == "quit") 
        {
            cout << "Assistant: Goodbye! Have a wonderful day. 🫂" << endl;
            break;
        }
        else if (lowerInput == "who is your owner" || lowerInput == "owner") 
        {
            cout << "Assistant: I was developed and built by Karthikeyan. 🛠️" << endl;
        }
        else if (lowerInput == "date" || lowerInput == "time" || lowerInput == "today") 
        {
            time_t now = time(0);
            char* dt = ctime(&now);
            cout << "Assistant: " << dt;
        }
        else if (lowerInput == "hi" || lowerInput == "hello") 
        {
            cout << "Assistant: Hello! I am your virtual assistant. How can I help you today?" << endl;
        }

        // --- 3. EV Battery Health Logic ---
        else if (lowerInput == "battery" || lowerInput == "range" || lowerInput == "ev health") 
        {
            double battery_percent;
            cout << "Assistant: What is your current battery percentage (0-100)? ";
            cin >> battery_percent;
            
            double pack_cycles;
            cout << "Assistant: Total charging cycles on the battery pack? ";
            cin >> pack_cycles;
            cin.ignore(1000, '\n'); 

            if (battery_percent >= 0 && battery_percent <= 100 && pack_cycles >= 0) 
            {
                double battery_health = 100.0 - (pack_cycles * 0.005);
                if (battery_health < 70.0) battery_health = 70.0; 

                double max_range_possible = 500.0 * (battery_health / 100.0);
                double current_range = max_range_possible * (battery_percent / 100.0);

                cout << "\n--- EV Pack Diagnostic Status ---" << endl;
                cout << "Battery State of Health (SoH): " << battery_health << "%" << endl;
                cout << "Estimated Current Range: " << current_range << " KM 🚗🔋" << endl;
            } 
            else cout << "Assistant: Invalid specifications entered. ❌" << endl;
        }

        // --- 4. Reminder Logic ---
        else if (lowerInput.find("remind me at") != string::npos)
        {
            string alarmTime = lowerInput.substr(13); 
            cout << "Assistant: Noted. I'll remind you at " << alarmTime << "! ⏰" << endl;
            
            bool reminded = false;
            while (!reminded) {
                time_t now = time(0);
                tm *ltm = localtime(&now);
                char currentTime[6];
                strftime(currentTime, sizeof(currentTime), "%H:%M", ltm);
                
                if (string(currentTime) == alarmTime)
                {
                    cout << "\n[REMINDER] 🔔 It is " << alarmTime << "! Time to work!" << endl;
                    reminded = true;
                }
                sleep(2); 
            }
        }

        // --- 5. [UPGRADED] Dynamic Success Task List System ---
        else if (lowerInput == "add task") {
            cout << "Assistant: Task to add: ";
            string newTask;
            getline(cin, newTask);
            
            // push_back automatically expands memory allocation on runtime
            tasks.push_back(newTask); 
            saveTasksToFile(); 
            cout << "Assistant: Added and saved to dynamic memory. ✅" << endl;
        }
        else if (lowerInput == "list" || lowerInput == "tasks") {
            cout << "\n--- Your Success Task List ---" << endl;
            if (tasks.empty()) cout << "No tasks yet. ✨" << endl;
            else {
                // tasks.size() adjusts dynamically based on exact item counts
                for (size_t i = 0; i < tasks.size(); i++) {
                    cout << i + 1 << ". " << tasks[i] << endl;
                }
            }
        }
        else if (lowerInput == "remove task" || lowerInput == "delete task") {
            if (tasks.empty()) {
                cout << "Assistant: Your list is already empty!" << endl;
            } else {
                int index;
                cout << "Assistant: Enter the task number to remove (1-" << tasks.size() << "): ";
                cin >> index;
                cin.ignore(1000, '\n');

                if (index >= 1 && index <= static_cast<int>(tasks.size())) {
                    // Native vector erasure cleanly pops the item out without manually shifting elements
                    tasks.erase(tasks.begin() + (index - 1));
                    saveTasksToFile(); 
                    cout << "Assistant: Task #" << index << " removed! 🗑️" << endl;
                } else cout << "Assistant: Invalid task number! ❌" << endl;
            }
        }
        else if (lowerInput == "clear list" || lowerInput == "reset list") {
            tasks.clear(); // Wipes vector bounds entirely
            saveTasksToFile(); 
            cout << "Assistant: The task list has been wiped clean from storage!" << endl;
        }

        // --- 6. Memory & Facts ---
        else if (lowerInput.find("remember") != string::npos)
        {
            string info = input.substr(9); 
            cout << "Assistant: I have noted: '" << info << "'! 🧠" << endl;
        }
        else if (lowerInput == "fact" || lowerInput == "tech")
        {
            string facts[] = {
                "The first computer virus was created in 1971! 🦠",
                "C++ was created by Bjarne Stroustrup! 👨‍💻",
                "The first programmer was Ada Lovelace! 👩‍💻",
                "Tesla car software runs on Linux! 🏎️"
            };
            int factIndex = time(0) % 4;
            cout << "Assistant: Did you know? " << facts[factIndex] << endl;
        }

        // --- 7. Smart Search Logic ---
        else if (lowerInput.find("search for") != string::npos) {
            string query = input.substr(11); 
            cout << "Assistant: Certainly Karthikeyan, searching Google for '" << query << "'... 🌐" << endl;
            string url = "https://www.google.com/search?q=" + query;
            string command = "am start -a android.intent.action.VIEW -d \"" + url + "\"";
            system(command.c_str());
        }

        // --- 8. Professional Shortcuts & Hubs ---
        else if (lowerInput == "github" || lowerInput == "git")  
        {
            cout << "Assistant: Opening GitHub... 🚀" << endl;
            system("am start -a android.intent.action.VIEW -d https://github.com/rushsvanth-cmyk");
        }
        else if (lowerInput == "tesla hub" || lowerInput == "tesla careers") {
            cout << "Assistant: Connecting to Tesla Engineering Careers dashboard, Karthikeyan... 🏎️⚡" << endl;
            system("am start -a android.intent.action.VIEW -d https://www.tesla.com/careers");
        }
        else if (lowerInput == "status")
        {
            cout << "\n--- Assistant Status ---" << endl;
            cout << "Version: 5.2 | Architecture: Dynamic Vector Containers | Core Target: Tesla Architect 🏎️" << endl;
            cout << "Total Tracked Tasks Stored: " << tasks.size() << " items" << endl;
            cout << "------------------------" << endl;
        }
        else if (lowerInput == "who is karthikeyan") {
            cout << "Assistant: Karthikeyan is a future Tesla Engineer! He is currently building me—his advanced virtual assistant. 🔥" << endl;
        }
        
        // --- 9. System Performance Metric ---
        else if (lowerInput == "system speed" || lowerInput == "latency") {
            auto end_time = chrono::high_resolution_clock::now();
            auto duration = chrono::duration_cast<chrono::microseconds>(end_time - start_time).count();
            cout << "Assistant: Internal engine latency check: " << duration << " microseconds. Running smoothly! ⚡" << endl;
        }

        // --- Default Response ---
        else 
        {
            cout << "Assistant: I didn't quite catch that. Try 'hi', 'status', or check your 'list'!" << endl;
        }
    } 

    return 0; 
}
