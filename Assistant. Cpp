#include <iostream>
#include <string>
#include <algorithm> 
#include <cmath>
#include <ctime>
#include <sstream> 
#include <unistd.h> // Required for sleep()

using namespace std;

int main() 
{
    string input;
    double num1, num2;
    char op;

    // Task List Storage
    static string tasks[5]; 
    static int taskCount = 0;

    cout << "--- System Online (V4.5) ---" << endl;
    cout << "(Commands: hi, date, battery, add task, list, remind me at HH:MM, exit)" << endl;

    while (true)
    {
        cout << "\nYou: ";
        getline(cin, input);

        if (input.empty()) continue;

        // --- 1. Automatic Math Detection ---
        if (isdigit(input[0])) 
        {
            stringstream ss(input);
            if (ss >> num1 >> op >> num2) 
            {
                cout << "Assistant (Math): ";
                switch(op) 
                {
                    case '+': cout << num1 + num2 << " ✅"; break;
                    case '-': cout << num1 - num2 << " ✅"; break;
                    case '*': cout << num1 * num2 << " ✅"; break;
                    case '/': 
                        if(num2 != 0) cout << num1 / num2 << " ✅";
                        else cout << "Error: Cannot divide by zero! ❌";
                        break;
                    case '^': cout << pow(num1, num2) << " 🔥"; break;
                    default: cout << "Unknown operator! 😅";
                }
                cout << endl;
                continue; 
            }
        }

        // --- 2. Lowercase conversion for chat logic ---
        string lowerInput = input;
        transform(lowerInput.begin(), lowerInput.end(), lowerInput.begin(), [](unsigned char c){ return tolower(c); });

        // Exit Command
        if (lowerInput == "exit" || lowerInput == "quit") 
        {
            cout << "Assistant: Goodbye! Have a wonderful day. 🫂" << endl;
            break;
        }
        // Identity
        else if (lowerInput == "who is your owner" || lowerInput == "owner" || lowerInput == "creator") 
        {
            cout << "Assistant: I was developed and built by Karthikeyan. He is my creator! 🛠️" << endl;
        }
        // Date and Time
        else if (lowerInput == "date" || lowerInput == "time" || lowerInput == "today") 
        {
            time_t now = time(0);
            char* dt = ctime(&now);
            cout << "Assistant: The current date and time is: " << dt;
        }
        // Greetings
        else if (lowerInput == "hi" || lowerInput == "hello") 
        {
            cout << "Assistant: Hello! I am your virtual assistant. How can I help you today?" << endl;
        }
        // --- 3. Tesla Battery Logic ---
        else if (lowerInput == "battery" || lowerInput == "range" || lowerInput == "tesla") 
        {
            double battery_percent;
            cout << "Assistant: What is your current battery percentage (0-100)? ";
            cin >> battery_percent;
            cin.ignore(1000, '\n'); 

            if (battery_percent >= 0 && battery_percent <= 100) 
            {
                double range = battery_percent * 5;
                cout << "Assistant: Estimated range is approximately " << range << " KM! 🚗🔋" << endl;
                if (battery_percent < 20) cout << "Assistant: Warning! Battery is low! ⚠️" << endl;
            } 
            else cout << "Assistant: Please enter a valid percentage. ❌" << endl;
        }
        // --- 4. Reminder Logic ---
        else if (lowerInput.find("remind me at") != string::npos)
        {
            string alarmTime = lowerInput.substr(13); 
            cout << "Assistant: Sure Karthikeyan, I will remind you at " << alarmTime << "! ⏰" << endl;
            
            bool reminded = false;
            while (!reminded) {
                time_t now = time(0);
                tm *ltm = localtime(&now);
                char currentTime[6];
                strftime(currentTime, sizeof(currentTime), "%H:%M", ltm);
                
                if (string(currentTime) == alarmTime)
                {
                    cout << "\n[REMINDER] 🔔 Karthikeyan, it is " << alarmTime << "! Time to start your work!" << endl;
                    reminded = true;
                }
                sleep(2); // Save battery
            }
        }
        // --- 5. Success Task List ---
        else if (lowerInput == "add task") {
            if (taskCount < 5) {
                cout << "Assistant: What task would you like to add, my friend?: ";
                string newTask;
                getline(cin, newTask);
                tasks[taskCount] = newTask;
                taskCount++;
                cout << "Assistant: Great! Task added. ✅" << endl;
            } else cout << "Assistant: List is full! ❌" << endl;
        }
        else if (lowerInput == "show task" || lowerInput == "list" || lowerInput == "tasks") {
            cout << "\n--- Your Success Task List ---" << endl;
            if (taskCount == 0) cout << "No tasks for now. Enjoy your free time! ✨" << endl;
            else {
                for (int i = 0; i < taskCount; i++) cout << i + 1 << ". " << tasks[i] << endl;
            }
        }
        else if (lowerInput == "clear list" || lowerInput == "reset list") {
            taskCount = 0;
            cout << "Assistant: The list is now empty!" << endl;
        }
        // Default Response
        else 
        {
            cout << "Assistant: I didn't quite catch that. Try 'hi', 'date', or 'battery'!" << endl;
        }
    }

    return 0;
}
