// Calculates a simple polynomial rolling hash string to match verification signatures
unsigned long long calculateSecureHash(const string& password) {
    unsigned long long hashValue = 5381; // Standard cryptographic constant base seed
    for (char c : password) {
        // Bitwise shifting multiplication trick: hash * 33 + char
        hashValue = ((hashValue << 5) + hashValue) + c;
    }
    return hashValue;
}

