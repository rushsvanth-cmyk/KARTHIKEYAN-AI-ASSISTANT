// LEVEL 4 CORE: TESLA BATTERY SYSTEM WITH CLASS CONSTRUCTORS
// ============================================================================
class TeslaBatterySystem {
private:
    const double baseRange;  // Explicitly set by Constructor
    const double teslaMass;  // Explicitly set by Constructor

public:
    // --- NEW: Parameterized Constructor with Member Initialization List ---
    TeslaBatterySystem(double maxRange, double weight) : baseRange(maxRange), teslaMass(weight) {
        cout << "[BMS Initialize]: Battery Pack Hardware Configured." << endl;
        cout << " -> Dynamic Base Range Cap: " << baseRange << " KM" << endl;
        cout << " -> Vehicle Curb Mass Profile: " << teslaMass << " kg" << endl;
    }

    // 1. Core State of Health & Dynamic Range Analysis
    void simulateEvRange(double soc, double mileage, double temp) {
        double soh = 1.0 - (mileage / 250000.0);
        if (soh < 0.70) soh = 0.70; 

        double tempFactor = 1.0;
        if (temp < 15.0) tempFactor = 1.0 - (15.0 - temp) * 0.015; 
        else if (temp > 35.0) tempFactor = 1.0 - (temp - 35.0) * 0.008; 
        if (tempFactor < 0.50) tempFactor = 0.50;

        double realWorldRange = baseRange * (soc / 100.0) * soh * tempFactor;
        
        cout << "\n🔋 Battery SoH: " << soh * 100.0 << "% | 🌡️ Thermal Efficiency: " << tempFactor * 100.0 << "%" << endl;
        cout << "⚡ Estimated Range: " << realWorldRange << " KM" << endl;
    }

    // 2. Supercharger Fast Charge Curve Optimizer
    void optimizeChargingCurve(double currentSoc) {
        if (currentSoc < 0 || currentSoc >= 100) {
            cout << "Assistant: Invalid SoC percentage loop. ❌" << endl;
            return;
        }
        double fastPhaseTime = 0, slowPhaseTime = 0;
        if (currentSoc < 80.0) {
            fastPhaseTime = (80.0 - currentSoc) / 2.5;
            slowPhaseTime = 20.0 / 0.8; 
        } else {
            slowPhaseTime = (100.0 - currentSoc) / 0.8;
        }
        cout << "\n🚀 Bulk Phase (Current -> 80%): Approx. " << fastPhaseTime << " mins" << endl;
        cout << "🐢 Taper Phase (80% -> 100%): Approx. " << slowPhaseTime << " mins" << endl;
        cout << "🏁 Total Session Time to Full: " << fastPhaseTime + slowPhaseTime << " minutes." << endl;
    }

    // 3. Kinetic Energy Recovery (KERS) Monitor
    void simulateRegenBraking(double initialSpeed, double finalSpeed, double duration) {
        if (initialSpeed <= finalSpeed || finalSpeed < 0 || duration <= 0) {
            cout << "Assistant: Invalid physics values. Initial speed must exceed target speed! ❌" << endl;
            return;
        }
        double v_i = initialSpeed / 3.6;
        double v_f = finalSpeed / 3.6;
        double kineticEnergyJoules = 0.5 * teslaMass * ((v_i * v_i) - (v_f * v_f));
        double recoveredWh = kineticEnergyJoules * (1.0 / 3600.0) * 0.75;
        double addedMeters = recoveredWh / 0.15;

        cout << "\n🔋 Pack Energy Recovered: " << recoveredWh << " Wh ⚡" << endl;
        cout << "🛣️ Free Range Added: " << addedMeters / 1000.0 << " KM" << endl;
    }

    // 4. Fluid Loop Thermal Control System
    void handleThermalOverride(double cellTemp) {
        cout << "\n--- HVAC Fluid Dynamics System Deployment ---" << endl;
        if (cellTemp >= 20.0 && cellTemp <= 35.0) {
            cout << "✅ Status: OPTIMAL. Fluid loops bypassing radiator. Power Draw: 0.0 kW" << endl;
        } 
        else if (cellTemp < 20.0) {
            double deficit = 20.0 - cellTemp;
            double heatPower = min(deficit * 0.45, 6.0);
            cout << "❄️ Status: CELL UNDER-TEMPERATURE. Activating Powertrain Heat Pump." << endl;
            cout << "⚡ Heating Power Consumption: " << heatPower << " kW" << endl;
        } 
        else {
            double surplus = cellTemp - 35.0;
            double coolPower = min(surplus * 0.65, 10.0);
            cout << "🔥 Status: CELL OVER-TEMPERATURE. Activating Chiller Refrigeration." << endl;
            cout << "⚡ Cooling Power Consumption: " << coolPower << " kW" << endl;
            if (cellTemp > 55.0) cout << "⚠️ WARNING: Thermal runaway mitigation threshold active!" << endl;
        }
    }
};

