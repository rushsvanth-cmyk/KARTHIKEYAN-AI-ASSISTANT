// ============================================================================
// --- TESLA BATTERY MANAGEMENT SYSTEM CLASS (OOP) ---
// ============================================================================
class TeslaBatteryManager {
private:
    double batteryPercent;
    double totalCycles;
    const double baselineRange = 500.0; 

    double calculateStateOfHealth() const {
        double health = 100.0 - (totalCycles * 0.005);
        return (health < 70.0) ? 70.0 : health; 
    }

public:
    TeslaBatteryManager() : batteryPercent(100.0), totalCycles(0) {}

    void setDiagnostics(double percent, double cycles) {
        if (percent < 0.0 || percent > 100.0) {
            throw invalid_argument("State of Charge outside physical parameters (0-100%).");
        }
        if (cycles < 0.0) {
            throw invalid_argument("Negative cycle matrix data rejected by BMS.");
        }
        batteryPercent = percent;
        totalCycles = cycles;
    }

    void displayHealthReport() const {
        double soh = calculateStateOfHealth();
        double maxRangePossible = baselineRange * (soh / 100.0);
        double currentRange = maxRangePossible * (batteryPercent / 100.0);

        cout << "\n--- EV Pack Diagnostic Status [BMS Class] ---" << endl;
        cout << "System Status               : Online & Monitoring" << endl;
        cout << "Battery State of Health(SoH): " << soh << "%" << endl;
        cout << "Target Adaptive Range       : " << currentRange << " KM 🚗🔋" << endl;
        cout << "---------------------------------------------" << endl;
    }
};

// ============================================================================
// --- FILE SYSTEM CONFIGURATION ---
// ============================================================================
const string FILE_NAME = "tasks.txt";
static vector<string> tasks; 

void saveTasksToFile() {
    ofstream outFile(FILE_NAME);
    if (outFile.is_open()) {
        for (const string& task : tasks) {
            outFile << task << endl;
        }
        outFile.close();
    }
}

void loadTasksFromFile() {
    ifstream inFile(FILE_NAME);
    if (inFile.is_open()) {
        string task;
        tasks.clear(); 
        while (getline(inFile, task)) {
            if (!task.empty()) tasks.push_back(task);
        }
        inFile.close();
    }
}

