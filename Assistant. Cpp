int main() 
{
    string input;
    double num1, num2;
    char op;

    vector<string> todoList; 
    
    // --- NEW: Creating the Object with targeted initialization values ---
    // Instantiating standard Model S Specifications (540 KM baseline range, 2108 kg)
    TeslaBatterySystem evSystem(540.0, 2108.0);

    // Load saved tasks on startup
    ifstream inFile("todo.txt");
    string savedTask;
    if (inFile.is_open()) {
        while (getline(inFile, savedTask)) {
