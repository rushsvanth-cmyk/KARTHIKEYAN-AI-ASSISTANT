// --- COMPONENT 1: NATURAL LANGUAGE PROCESSING & PARSER ENGINE ---
// ============================================================================
class NLPCommandParser {
private:
    set<string> stopWords;

public:
    NLPCommandParser() {
        // Initialize noise words to clear vocabulary channels
        stopWords = {"please", "can", "you", "the", "a", "an", "is", "me", "my", "show", "tell", "check", "hey"};
    }

    bool parseIntent(const string& rawInput, const vector<string>& targetKeywords) const {
        string processed = rawInput;
        transform(processed.begin(), processed.end(), processed.begin(), [](unsigned char c){ return tolower(c); });
        
        // Sanitize punctuation
        for (char &charByte : processed) {
            if (charByte == '?' || charByte == '!' || charByte == '.' || charByte == ',') charByte = ' ';
        }

        stringstream stream(processed);
        string token;
        
        while (stream >> token) {
            if (stopWords.find(token) != stopWords.end()) continue; // Skip noise tokens
            for (const string& keyword : targetKeywords) {
                if (token == keyword) return true;
            }
        }
        return false;
    }
};

