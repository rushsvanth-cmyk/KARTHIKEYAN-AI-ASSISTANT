        }
        inFile.close();
    }

    displayBanner();

    while (true)
    {
        cout << "\nYou: ";
        getline(cin, input);
        if (input.empty()) continue;

        string lowerInput = input;
        transform(lowerInput.begin(), lowerInput.end(), lowerInput.begin(), [](unsigned char c){ return tolower(c); });

        // 1. Math Intercept
        if (isdigit(input[0])) {
            stringstream ss(input);
            if (ss >> num1 >> op >> num2) {
                cout << "Assistant (Math): ";
                switch(op) {
                    case '+': cout << num1 + num2 << " ✅"; break;
                    case '-': cout << num1 - num2 << " ✅"; break;
                    case '*': cout << num1 * num2 << " ✅"; break;
                    case '/': cout << (num2 != 0 ? to_string(num1 / num2) : "Error! ❌"); break;
                    default: cout << "Unknown operator!";
                }
                cout << endl; continue; 
            }
        }

        // 2. Base System Infrastructure
        if (lowerInput == "exit" || lowerInput == "quit") {
            cout << "Assistant: Goodbye Karthikeyan! Heading to Tesla HQ... 🏎️🫂" << endl;
            break;
        }
        else if (lowerInput == "hi" || lowerInput == "hello") {
            cout << "Assistant: Hello creator! Ready to build the future today?" << endl;
        }
        else if (lowerInput == "clear" || lowerInput == "cls") {
            cout << "\033[2J\033[1;1H"; displayBanner(); continue;
        }

        // 3. Class Object Interaction Passes
        else if (lowerInput == "simulate ev" || lowerInput == "ev physics") {
            double soc, mileage, temp;
            cout << "Enter Battery % (SoC): "; cin >> soc;
            cout << "Enter Total Mileage (KM): "; cin >> mileage;
            cout << "Enter Ambient Temp (°C): "; cin >> temp; cin.ignore();
            evSystem.simulateEvRange(soc, mileage, temp);
        }
        else if (lowerInput == "optimize charge" || lowerInput == "charging curve") {
            double currentSoc;
            cout << "Enter current SoC (0-99): "; cin >> currentSoc; cin.ignore();
            evSystem.optimizeChargingCurve(currentSoc);
        }
        else if (lowerInput == "simulate regen" || lowerInput == "regen") {
            double initialSpeed, finalSpeed, duration;
            cout << "Enter Initial Speed (km/h): "; cin >> initialSpeed;
            cout << "Enter Target Speed (km/h): "; cin >> finalSpeed;
            cout << "Enter Duration (seconds): "; cin >> duration; cin.ignore();
            evSystem.simulateRegenBraking(initialSpeed, finalSpeed, duration);
        }
        else if (lowerInput == "thermal override" || lowerInput == "hvac") {
            double cellTemp;
            cout << "Enter Battery Cell Temperature (°C): "; cin >> cellTemp; cin.ignore();
            evSystem.handleThermalOverride(cellTemp);
        }

        // 4. Data Stack Controls
        else if (lowerInput == "add task") {
            string newTask; cout << "Assistant: What task are we tackling next?: ";
            getline(cin, newTask); todoList.push_back(newTask); saveTasksToFile(todoList);
            cout << "Assistant: Saved! Total tasks: " << todoList.size() << endl;
        }
        else if (lowerInput == "view task" || lowerInput == "tasks") {
            cout << "\n--- Active Stack ---" << endl;
            if (todoList.empty()) cout << "No tasks found! ✨" << endl;
            for (size_t i = 0; i < todoList.size(); ++i) cout << i + 1 << ". " << todoList[i] << endl;
        }
        else if (lowerInput == "delete task" || lowerInput == "remove task") {
            if (todoList.empty()) { cout << "Stack empty! ✨" << endl; continue; }
            int index; cout << "Enter task number: "; cin >> index; cin.ignore();
            if (index > 0 && index <= (int)todoList.size()) {
                todoList.erase(todoList.begin() + (index - 1)); saveTasksToFile(todoList);
                cout << "Assistant: Task purged. 🎯" << endl;
            }
        }

        // 5. Diagnostics & Telemetry
        else if (lowerInput == "runtime" || lowerInput == "uptime") {
            auto currentTime = chrono::steady_clock::now();
            auto totalSeconds = chrono::duration_cast<chrono::seconds>(currentTime - startTime).count();
            cout << "System Core Uptime: " << totalSeconds / 3600 << "h " << (totalSeconds % 3600) / 60 << "m " << totalSeconds % 60 << "s" << endl;
        }
        else if (lowerInput == "schedule") {
            cout << "\n--- 🎯 Routine Balance ---\n🌅 06:00 AM - 07:30 AM -> RSS Shakha Drill\n💻 04:00 PM - 07:00 PM -> C++ Coding & GitHub Commits 🟩" << endl;
        }
        else if (lowerInput == "milestones") {
            cout << "\n--- 🏎️ PROJECT MILESTONES ---\n[✅] Level 1: Core Syntax & CLI Assistant -> 100%\n[✅] Level 2: OOP & STL Vectors -> 100%\n[✅] Level 3: Advanced EV Battery Simulation -> 100%\n[⏳] Level 4: Object-Oriented Architecture -> (CURRENT LEVEL - 50% DONE)" << endl;
        }
        else if (lowerInput == "status") {
            cout << "V8.1 | Dev: Karthikeyan | Architecture: OOP Constructors | Target: Tesla 2035 🏎️" << endl;
        }
        else if (lowerInput == "github") {
            system("am start -a android.intent.action.VIEW -d https://github.com/rushsvanth-cmyk");
        }
        else {
            cout << "Assistant: Unrecognized command sequence. Try 'simulate ev' or 'milestones'!" << endl;
        }
    } 
    return 0; 
} 

