struct TelemetryFrame {
    double stockPrice;
    string marketStatus;
    unsigned long long marketCap;
};

class TeslaVehicleController {
private:
    double batteryPercent;
    double totalCycles;
    const double baselineRange = 500.0; 

    double calculateStateOfHealth() const {
        double health = 100.0 - (totalCycles * 0.005);
        return (health < 70.0) ? 70.0 : health; 
    }

    // Parallel Background Thread Worker Target for Network Telemetry Sim
    static TelemetryFrame queryCloudTelemetryNode() {
        sleep(2); // Simulated latency delay
        TelemetryFrame packet;
        packet.stockPrice = 382.82; // Real-world data point tracking
        packet.marketStatus = "Active / Nominal Operational Loop";
        packet.marketCap = 1199678748284ULL; // ~1.19 Trillion capitalization frame
        return packet;
    }

public:
    TeslaVehicleController() : batteryPercent(100.0), totalCycles(0) {}

    void executeBMSDiagnostics() {
        cout << "Assistant: What is your current battery percentage (0-100)? ";
        if (!(cin >> batteryPercent)) throw runtime_error("Invalid data type configuration.");
        cout << "Assistant: Total charging cycles on the pack? ";
        if (!(cin >> totalCycles)) throw runtime_error("Invalid data type configuration.");
        cin.ignore(1000, '\n'); 

        if (batteryPercent < 0.0 || batteryPercent > 100.0 || totalCycles < 0.0) {
            throw invalid_argument("Telemetry metrics fall outside nominal boundaries.");
        }

        double soh = calculateStateOfHealth();
        double currentRange = (baselineRange * (soh / 100.0)) * (batteryPercent / 100.0);

        cout << "\n--- EV Pack Diagnostic Status [BMS Component] ---" << endl;
        cout << "Battery State of Health (SoH): " << soh << "%" << endl;
        cout << "Target Adaptive Range        : " << currentRange << " KM 🚗🔋" << endl;
        cout << "-------------------------------------------------" << endl;
    }

    void streamLiveCloudTelemetry() const {
        cout << "Assistant: Launching async network telemetry probe... 📡" << endl;
        future<TelemetryFrame> responsePipeline = async(launch::async, queryCloudTelemetryNode);
        
        while(responsePipeline.wait_for(chrono::milliseconds(400)) != future_status::ready) {
            cout << "[System Bus: Pinging Cloud Server Matrix...]" << endl;
        }
        
        TelemetryFrame cloudData = responsePipeline.get();
        cout << "\n--- Async Telemetry Stream ($TSLA) ---" << endl;
        cout << "Spot Trading Target : $" << cloudData.stockPrice << " USD" << endl;
        cout << "Network Registry    : " << cloudData.marketStatus << endl;
        cout << "Total Valuation Cap : $" << cloudData.marketCap << " Valuation" << endl;
        cout << "----------------------------------------" << endl;
    }
};

// ============================================================================
// --- COMPONENT 3: PERSISTENT MEMORY & TASK STORAGE CONTROLLER ---
// ============================================================================
class TaskMemoryController {
private:
    string storageFileName;
    vector<string> dataVector;

public:
    TaskMemoryController(string filename) : storageFileName(filename) {}

    void commitStorageToDisk() const {
        ofstream file(storageFileName);
        if (file.is_open()) {
            for (const string& entry : dataVector) file << entry << endl;
            file.close();
        }
    }

    void loadStorageFromDisk() {
        ifstream file(storageFileName);
        if (file.is_open()) {
            string currentLine;
            dataVector.clear();
            while (getline(file, currentLine)) {
                if (!currentLine.empty()) dataVector.push_back(currentLine);
            }
            file.close();
        }
    }

    void addNewTask() {
        cout << "Assistant: Task description to add: ";
        string description;
        getline(cin, description);
        dataVector.push_back(description);
        commitStorageToDisk();
        cout << "Assistant: Entry saved dynamically. ✅" << endl;
    }

    void displayActiveWorkload() const {
        cout << "\n--- Your Success Task List ---" << endl;
        if (dataVector.empty()) cout << "No tasks populated. ✨" << endl;
        else {
            for (size_t i = 0; i < dataVector.size(); ++i) {
                cout << i + 1 << ". " << dataVector[i] << endl;
            }
        }
    }

    void purgeTaskElement() {
        if (dataVector.empty()) {
            cout << "Assistant: Data registers empty." << endl;
            return;
        }
        int index;
        cout << "Assistant: Enter element sequence address to purge (1-" << dataVector.size() << "): ";
        if (!(cin >> index)) throw runtime_error("Target conversion index fault.");
        cin.ignore(1000, '\n');

        if (index < 1 || index > static_cast<int>(dataVector.size())) {
            throw out_of_range("Memory matrix boundary fault.");
        }
        dataVector.erase(dataVector.begin() + (index - 1));
        commitStorageToDisk();
        cout << "Assistant: Task element erased. 🗑️" << endl;
    }

    void wipeMemoryBank() {
        dataVector.clear();
        commitStorageToDisk();
        cout << "Assistant: Persistent workload wiped cleanly." << endl;
    }

    size_t getVectorSize() const { return dataVector.size(); }
    const vector<string>& getRawTasks() const { return dataVector; }
};

