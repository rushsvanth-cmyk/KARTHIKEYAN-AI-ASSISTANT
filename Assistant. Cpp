#include <iostream>
#include <string>
#include <algorithm> 
#include <cmath>
#include <ctime>
#include <sstream> // Required to parse math expressions automatically

using namespace std;

int main() {
    string input;
    double num1, num2;
    char op;

    cout << "--- System Online (V4.0 - Auto Sense) ---" << endl;
    cout << "(Commands: hi, date, owner, exit or just type math like '5 + 2')" << endl;

    while (true) {
        cout << "\nYou: ";
        getline(cin, input);

        if (input.empty()) continue;

        // --- 1. Automatic Math Detection ---
        // If the first character is a digit, treat it as a calculation
        if (isdigit(input[0])) {
            stringstream ss(input);
            if (ss >> num1 >> op >> num2) {
                cout << "Assistant (Math): ";
                switch(op) {
                    case '+': cout << num1+num2 << " ✅"; break;
                    case '-': cout << num1-num2 << " ✅"; break;
                    case '*': cout << num1*num2 << " ✅"; break;
                    case '/': 
                        if(num2 != 0) cout << num1/num2 << " ✅";
                        else cout << "Error: Cannot divide by zero! ❌";
                        break;
                    case '^': cout << pow(num1, num2) << " 🔥"; break;
                    default: cout << "Unknown operator! 😅";
                }
                cout << endl;
                continue; // Skip the chat logic and wait for next input
            }
        }

        // --- 2. Chat Mode Logic ---
        // Convert input to lowercase for command processing
        transform(input.begin(), input.end(), input.begin(), [](unsigned char c){ return tolower(c); });

        if (input == "exit" || input == "quit") {
            cout << "Assistant: Goodbye! Have a wonderful day. 🫂" << endl;
            break;
        }
        else if (input == "who is your owner" || input == "owner") {
            cout << "Assistant: I was developed and built by Karthikeyan. He is my creator! 🛠️" << endl;
        }
        else if (input == "date" || input == "time" || input == "today") {
            time_t now = time(0);
            char* dt = ctime(&now);
            cout << "Assistant: The current date and time is: " << dt;
        }
        else if (input == "hi" || input == "hello" || input == "hey") {
            cout << "Assistant: Hello! I am your virtual assistant. How can I help you today?" << endl;
        }
        else {
            cout << "Assistant: I didn't quite get that. Try 'hi', 'date', or a math problem like '10 * 5'!" << endl;
        }
    }

    return 0;
}
