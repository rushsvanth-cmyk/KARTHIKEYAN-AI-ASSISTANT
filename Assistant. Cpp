// Tokenizes input text, filters out grammatical noise, and checks for keyword matches
bool dynamicIntentMatch(const string& rawInput, const vector<string>& targetKeywords) {
    string processed = rawInput;
    transform(processed.begin(), processed.end(), processed.begin(), [](unsigned char c){ return tolower(c); });

    // Clean up punctuation marks to isolate pure tokens
    for (char &c : processed) {
        if (c == '?' || c == '!' || c == '.' || c == ',') c = ' ';
    }

    // Stop-words list (words to ignore so the system focuses only on intent)
    static const set<string> stopWords = {"please", "can", "you", "the", "a", "an", "is", "me", "my", "show", "tell", "check"};

    stringstream ss(processed);
    string token;
    
    // Check if any extracted keyword matches our intent targets
    while (ss >> token) {
        if (stopWords.find(token) != stopWords.end()) continue; // Skip noise words
        
        for (const string& keyword : targetKeywords) {
            if (token == keyword) return true;
        }
    }
    return false;
}

