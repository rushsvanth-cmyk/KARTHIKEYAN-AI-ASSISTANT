#include <iostream>
#include <string>
#include <algorithm> 
#include <cmath>
#include <ctime>
#include <sstream> 
#include <unistd.h> 
#include <fstream> 

using namespace std;

int main() 
{
    string input;
    double num1, num2;
    char op;

    static string tasks[5]; 
    static int taskCount = 0;

    cout << "--- System Online (V5.4 - Environmental) ---" << endl;
    cout << "(Commands: hi, status, weather, hydrate, motivation, add event, exit)" << endl;

    while (true)
    {
        cout << "\nYou: ";
        getline(cin, input);
        if (input.empty()) continue;

        string lowerInput = input;
        transform(lowerInput.begin(), lowerInput.end(), lowerInput.begin(), [](unsigned char c){ return tolower(c); });

        // 1. Automatic Math Detection
        if (isdigit(input[0])) 
        {
            stringstream ss(input);
            if (ss >> num1 >> op >> num2) 
            {
                cout << "Assistant (Math): ";
                switch(op) {
                    case '+': cout << num1 + num2 << " ✅"; break;
                    case '-': cout << num1 - num2 << " ✅"; break;
                    case '*': cout << num1 * num2 << " ✅"; break;
                    case '/': 
                        if(num2 != 0) cout << num1 / num2 << " ✅";
                        else cout << "Error! Cannot divide by zero. ❌";
                        break;
                    case '^': cout << pow(num1, num2) << " 🔥"; break;
                    default: cout << "Unknown operator! 😅";
                }
                cout << endl; continue; 
            }
        }

        // 2. System Commands
        if (lowerInput == "exit" || lowerInput == "quit") {
            cout << "Assistant: Goodbye Karthikeyan! Heading to Tesla HQ... 🏎️🫂" << endl;
            break;
        }
        else if (lowerInput == "hi" || lowerInput == "hello") {
            cout << "Assistant: Hello creator! Ready to build the future today?" << endl;
        }
        
        // 3. Dev Notepad
        else if (lowerInput == "write note") {
            ofstream outfile;
            outfile.open("notes.txt", ios_base::app);
            cout << "Assistant: What should I write down?: ";
            string note; getline(cin, note);
            outfile << note << endl;
            outfile.close();
            cout << "Assistant: Note saved to memory! 📝" << endl;
        }
        else if (lowerInput == "read note") {
            ifstream infile("notes.txt");
            string line;
            cout << "--- Your Dev Notes ---" << endl;
            if (infile.is_open()) {
                while (getline(infile, line)) cout << "- " << line << endl;
                infile.close();
            } else cout << "No notes found! ✨" << endl;
        }

        // 4. Motivation
        else if (lowerInput == "motivation") {
            string quotes[] = {
                "Karthikeyan, the stage at Tesla 2035 is waiting for you! 🏎️",
                "Every line of code is a step toward success. Keep going! 💻",
                "Hard work always pays off. Stay focused! 🔥",
                "Your assistant is getting smarter every day, just like you! 🚀"
            };
            srand(time(0));
            cout << "Assistant: " << quotes[rand() % 4] << endl;
        }

        // 5. Special Day Reminder
        else if (lowerInput == "add event") {
            string date, eventName;
            cout << "Assistant: Enter the date (DD/MM): ";
            cin >> date;
            cout << "Assistant: Occasion?: ";
            cin.ignore();
            getline(cin, eventName);
            ofstream eventFile("events.txt", ios_base::app);
            eventFile << date << " " << eventName << endl;
            eventFile.close();
            cout << "Assistant: Event saved. ✅" << endl;
        }
        else if (lowerInput == "today") {
            time_t now = time(0); tm *ltm = localtime(&now);
            char curDate[6]; strftime(curDate, sizeof(curDate), "%d/%m", ltm); 
            ifstream eventFile("events.txt");
            string fDate, fEvent; bool found = false;
            while (eventFile >> fDate) {
                getline(eventFile, fEvent);
                if (fDate == string(curDate)) {
                    cout << "🔔 [Event Today!]:" << fEvent << " 🚀" << endl;
                    found = true;
                }
            }
            if (!found) cout << "Assistant: Nothing special today! ✨" << endl;
        }

        // 6. Environment (Chennai Focus)
        else if (lowerInput == "weather" || lowerInput == "climate") {
            cout << "Assistant: Checking Chennai weather for you... ☀️" << endl;
            system("am start -a android.intent.action.VIEW -d \"https://www.google.com/search?q=weather+chennai\"");
        }
        else if (lowerInput == "hydrate" || lowerInput == "health") {
            cout << "Assistant: It's likely warm in Chennai. Drink water, Karthikeyan! 💧" << endl;
        }

        // 7. Tesla Battery & Status
        else if (lowerInput == "battery") {
            double p; cout << "Assistant: Battery %? "; cin >> p; cin.ignore();
            if (p >= 0 && p <= 100) cout << "Assistant: Estimated Range: " << p * 5 << " KM! 🚗🔋" << endl;
        }
        else if (lowerInput == "status") {
            cout << "V5.4 | Dev: Karthikeyan | Location: Chennai | Goal: Tesla 2035 🏎️" << endl;
        }
        else {
            cout << "Assistant: Command not recognized. Try 'status' or 'weather'!" << endl;
        }
    } // Loop ends here
    return 0; 
