using namespace std;

void displayBanner() {
    cout << "--- System Online (V6.2 - File Persistence) ---" << endl;
    cout << "(Commands: hi, status, battery, charge, model, add task, view task, delete task, schedule, milestones, clear, exit)" << endl;
}

// Helper function to save tasks to file
void saveTasksToFile(const vector<string>& list) {
    ofstream outFile("todo.txt");
    if (outFile.is_open()) {
        for (const string& task : list) {
            outFile << task << endl;
        }
        outFile.close();
    }
}

int main() 
{
    string input;
    double num1, num2;
    char op;

    // Level 2 Core Array Stack
    vector<string> todoList; 

    // --- NEW: Load Saved Tasks on Startup (V6.2) ---
    ifstream inFile("todo.txt");
    string savedTask;
    if (inFile.is_open()) {
        while (getline(inFile, savedTask)) {
            if (!savedTask.empty()) {
                todoList.push_back(savedTask);
            }
        }
        inFile.close();
    }

    displayBanner();
    if (!todoList.empty()) {
        cout << "Assistant: Loaded " << todoList.size() << " pending tasks from memory! 💾" << endl;
    }

    while (true)
    {
        cout << "\nYou: ";
        getline(cin, input);
        if (input.empty()) continue;

        string lowerInput = input;
        transform(lowerInput.begin(), lowerInput.end(), lowerInput.begin(), [](unsigned char c){ return tolower(c); });

        // 1. Automatic Math Detection
        if (isdigit(input[0])) 
        {
            stringstream ss(input);
            if (ss >> num1 >> op >> num2) 
            {
                cout << "Assistant (Math): ";
                switch(op) {
                    case '+': cout << num1 + num2 << " ✅"; break;
                    case '-': cout << num1 - num2 << " ✅"; break;
                    case '*': cout << num1 * num2 << " ✅"; break;
                    case '/': 
                        if(num2 != 0) cout << num1 / num2 << " ✅";
                        else cout << "Error! Cannot divide by zero. ❌";
                        break;
                    case '^': cout << pow(num1, num2) << " 🔥"; break;
                    default: cout << "Unknown operator! 😅";
                }
                cout << endl; continue; 
            }
        }

        // 2. System Commands
        if (lowerInput == "exit" || lowerInput == "quit") {
            cout << "Assistant: Goodbye Karthikeyan! Heading to Tesla HQ... 🏎️🫂" << endl;
            break;
        }
        else if (lowerInput == "hi" || lowerInput == "hello") {
            cout << "Assistant: Hello creator! Ready to build the future today?" << endl;
        }
        
        // 3. Clear Screen Logic
        else if (lowerInput == "clear" || lowerInput == "cls") {
            cout << "\033[2J\033[1;1H"; 
            displayBanner();
            continue;
        }

        // 4. Dynamic STL Task Management with Persistence
        else if (lowerInput == "add task") {
            string newTask;
            cout << "Assistant: What task are we tackling next, Karthikeyan?: ";
            getline(cin, newTask);
            todoList.push_back(newTask); 
            saveTasksToFile(todoList); // Auto-save on addition
            cout << "Assistant: Task saved to file! Total active tasks: " << todoList.size() << " 🚀" << endl;
        }
        else if (lowerInput == "view task" || lowerInput == "tasks") {
            cout << "\n--- Your Active Stack ---" << endl;
            if (todoList.empty()) {
                cout << "No active tasks! You are clear to focus on C++ or RSS drills. ✨" << endl;
            } else {
                for (size_t i = 0; i < todoList.size(); ++i) {
                    cout << i + 1 << ". " << todoList[i] << endl;
                }
            }
        }
        else if (lowerInput == "delete task" || lowerInput == "remove task") {
            if (todoList.empty()) {
                cout << "Assistant: The stack is empty! Nothing to delete. ✨" << endl;
            } else {
                int index;
                cout << "Assistant: Enter task number to delete (1-" << todoList.size() << "): ";
                cin >> index;
                cin.ignore(); 

                if (index > 0 && index <= (int)todoList.size()) {
                    todoList.erase(todoList.begin() + (index - 1));
                    saveTasksToFile(todoList); // Auto-save after deletion
                    cout << "Assistant: Task removed from memory and file! Remaining: " << todoList.size() << " 🎯" << endl;
                } else {
                    cout << "Assistant: Invalid task number! ❌" << endl;
                }
            }
        }

        // 5. Dev Notepad
        else if (lowerInput == "write note") {
            ofstream outfile;
            outfile.open("notes.txt", ios_base::app);
            cout << "Assistant: What should I write down?: ";
            string note; getline(cin, note);
            outfile << note << endl;
            outfile.close();
            cout << "Assistant: Note saved to memory! 📝" << endl;
        }
        else if (lowerInput == "read note") {
            ifstream infile("notes.txt");
            string line;
            cout << "--- Your Dev Notes ---" << endl;
            if (infile.is_open()) {
                while (getline(infile, line)) cout << "- " << line << endl;
                infile.close();
            } else cout << "No notes found! ✨" << endl;
        }

        // 6. Motivation
        else if (lowerInput == "motivation") {
            string quotes[] = {
                "Karthikeyan, the stage at Tesla 2035 is waiting for you! 🏎️",
                "Every line of code is a step toward success. Keep going! 💻",
                "Hard work always pays off. Stay focused! 🔥",
                "Your assistant is getting smarter every day, just like you! 🚀"
            };
            srand(time(0));
            cout << "Assistant: " << quotes[rand() % 4] << endl;
        }

        // 7. Special Day Reminder
        else if (lowerInput == "add event") {
            string date, eventName;
            cout << "Assistant: Enter the date to remember (DD/MM): ";
            cin >> date;
            cout << "Assistant: What is the occasion?: ";
            cin.ignore();
            getline(cin, eventName);
            
            ofstream eventFile("events.txt", ios_base::app);
            eventFile << date << " " << eventName << endl;
            eventFile.close();
            cout << "Assistant: Noted! ✅";
        }
        else if (lowerInput == "today") {
            time_t now = time(0); tm *ltm = localtime(&now);
            char curDate[6]; strftime(curDate, sizeof(curDate), "%d/%m", ltm); 
            ifstream eventFile("events.txt");
            string fileDate, fileEvent; bool found = false;
            while (eventFile >> fileDate) {
                getline(eventFile, fileEvent);
                if (fileDate == string(curDate)) {
                    cout << "🔔 [Special Event Today!]:" << fileEvent << " 🚀" << endl;
                    found = true;
                }
            }
            if (!found) cout << "Assistant: Nothing special on the calendar for today! ✨" << endl;
            eventFile.close();
        }

        // 8. Tesla Battery Core Logic
        else if (lowerInput == "battery") {
            double p; cout << "Assistant: Battery %? "; cin >> p; cin.ignore();
            if (p >= 0 && p <= 100) cout << "Assistant: Estimated Range: " << p * 5 << " KM! 🚗🔋" << endl;
        }
        else if (lowerInput == "charge") {
            double current_pct; cout << "Assistant: Current battery percentage (0-100)?: "; cin >> current_pct; cin.ignore();
            if (current_pct >= 0 && current_pct < 100) {
                double needed = 100.0 - current_pct;
                cout << "\n--- Charging Estimates to 100% ---" << endl;
                cout << "⚡ Tesla Home Wall Connector: Approx. " << (needed / 0.12) / 60 << " hours." << endl;
                cout << "⚡ Tesla Supercharger V3: Approx. " << needed / 2.0 << " minutes." << endl;
            }
        }

        // 9. Tesla Model Fleet Customizer
        else if (lowerInput == "model") {
            int choice; cout << "Enter Model choice (1-4): "; cin >> choice; cin.ignore();
            if (choice == 1) cout << "🚗 Model S Plaid | 🔋 637 KM | ⚡ 0-100: 2.1s 🔥" << endl;
            else if (choice == 2) cout << "🚗 Model 3 LR | 🔋 576 KM | ⚡ 0-100: 4.2s" << endl;
            else if (choice == 3) cout << "🚗 Model X Plaid | 🔋 536 KM | ⚡ 0-100: 2.6s" << endl;
            else if (choice == 4) cout << "🚗 Model Y Perf | 🔋 488 KM | ⚡ 0-100: 3.6s" << endl;
        }

        // 10. Balanced Schedule Optimizer
        else if (lowerInput == "schedule") {
            cout << "\n--- 🎯 Routine Balance ---" << endl;
            cout << "🌅 06:00 AM - 07:30 AM -> RSS Shakha Drill" << endl;
            cout << "💻 04:00 PM - 07:00 PM -> C++ Coding & GitHub Commits 🟩" << endl;
        }

        // 11. Tesla Project Milestone Tracker
        else if (lowerInput == "milestones") {
            cout << "\n--- 🏎️ PROJECT MILESTONES ---" << endl;
            cout << "[✅] Level 1: Core Syntax & CLI Assistant ---> 100% DONE! 🎉" << endl;
            cout << "[⏳] Level 2: OOP & STL Vectors ---> (CURRENT LEVEL - 50% DONE)" << endl;
        }

        // 12. Environment & Weather
        else if (lowerInput == "weather") {
            system("am start -a android.intent.action.VIEW -d \"https://www.google.com/search?q=weather+chennai\"");
        }

        // 13. Status & Profile Links
        else if (lowerInput == "status") {
            cout << "V6.2 | Dev: Karthikeyan | Layer: File Persistence Core | Target: Tesla 2035 🏎️" << endl;
        }
        else if (lowerInput == "github") {
            system("am start -a android.intent.action.VIEW -d https://github.com/rushsvanth-cmyk");
        }
        else {
            cout << "Assistant: Unrecognized entry. Try 'add task', 'delete task', or 'view task'!" << endl;
        }
    } 
    return 0; 
}
